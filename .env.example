# ==========================================
# E0 Finder — Production Environment Variables
# ==========================================

# Supabase Public API (Accessible by client & server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Server-side Admin / Service Role (Keep secret, never prefix with NEXT_PUBLIC_)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google Maps API (Client & Maps SDK)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Direct Postgres DB Connections (Optional / Prisma / Migrations)
POSTGRES_HOST="db.your-project.supabase.co"
POSTGRES_DATABASE="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-db-password"
